{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cs408-standalone-question-supplement-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "capture_id",
    "parent_package_locator",
    "parent_package_sha256",
    "new_turns",
    "authorization"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{2,159}$"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "user_message"
      ],
      "properties": {
        "schema": {
          "const": "cs408-explicit-fast-intake-authorization-v1"
        },
        "kind": {
          "const": "explicit_fast_intake"
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "question_image",
              "solution_image",
              "explanation_image",
              "user_work_image",
              "source_article_image",
              "other_attachment"
            ]
          },
          "mime_type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "frozen_feedback": {
      "type": "string"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "schema": {
      "const": "cs408-standalone-question-supplement-v1"
    },
    "capture_id": {
      "type": "string"
    },
    "parent_package_locator": {
      "type": "string"
    },
    "parent_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "new_turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant",
              "learner"
            ]
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
