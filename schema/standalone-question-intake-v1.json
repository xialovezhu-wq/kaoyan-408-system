{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cs408-standalone-question-intake-v1",
  "title": "408 standalone question intake",
  "$comment": "Runtime also proves no managed display/session/navigation surface; authorization.user_message byte-equals the latest user turn; an NFKC whole-command check accepts explicit quick intake and rejects negation, questions, conditions, quotations, and split keywords. study_date is part of item identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "study_date",
    "authorization",
    "source",
    "conversation"
  ],
  "properties": {
    "schema": {
      "const": "cs408-standalone-question-intake-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+-]{2,159}$"
    },
    "study_date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "user_message"],
      "properties": {
        "schema": {
          "const": "cs408-explicit-fast-intake-authorization-v1"
        },
        "kind": {
          "const": "explicit_fast_intake"
        },
        "user_message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question_identity_hint": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "year": {"type": "string"},
        "subject": {"type": "string"},
        "question_type": {"type": "string"},
        "locator": {"type": "string"},
        "question": {"type": "string"},
        "options": {"$ref": "#/$defs/options"}
      }
    },
    "question": {"type": "string"},
    "options": {"$ref": "#/$defs/options"},
    "conversation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": {"enum": ["user", "assistant", "learner"]},
          "kind": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "observed_at": {"type": ["string", "null"]}
        }
      }
    },
    "frozen_feedback": {"type": "string"},
    "attachments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {
            "enum": [
              "question_image",
              "solution_image",
              "explanation_image",
              "user_work_image",
              "source_article_image",
              "other_attachment"
            ]
          },
          "mime_type": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "anyOf": [
    {
      "required": ["question"],
      "properties": {"question": {"type": "string", "minLength": 1}}
    },
    {
      "properties": {
        "source": {
          "required": ["source_id", "question"],
          "properties": {"question": {"type": "string", "minLength": 1}}
        }
      }
    },
    {
      "required": ["attachments"],
      "properties": {
        "attachments": {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": {"role": {"const": "question_image"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "options": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  }
}
