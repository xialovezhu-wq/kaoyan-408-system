diff --git a/tests/test_longmemeval_v2_teaching_408.py b/tests/test_longmemeval_v2_teaching_408.py
new file mode 100644
index 0000000..0ce9bbc
--- /dev/null
+++ b/tests/test_longmemeval_v2_teaching_408.py
@@ -0,0 +1,73 @@
+"""Synthetic boundary cases for the bounded 408 teaching projection."""
+import json
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+import teaching_memory_408 as teaching
+
+
+CASES = {
+    "C01": ("字节编址且块为32字节时，块内位数为5。",
+            "每字4字节且按字编址时，同一块含8个可编址字，块内位数为3。"),
+    "C02": ("已连续收到编号小于100的字节，之后收到[120,140)，累计ACK仍为100。",
+            "普通数据按字节占序号，SYN和FIN各占一个序号。"),
+    "C03": ("TLB未命中但页表项表示页已驻留且访问合法，完成翻译，无需处理缺页。",
+            "访问合法、目标页未驻留时发生缺页，调入成功后重试原访存。"),
+    "C04": ("P1运行时间6、时刻0到达，P2运行时间2、时刻1到达；非抢占SJF下P1先完成。",
+            "最短剩余时间优先可在时刻1抢占，P2运行至时刻3再继续P1。"),
+    "C05": ("无权图中BFS求最少边数，从起点按层扩展。",
+            "一般图带非负边权时可用Dijkstra求最小权值和。"),
+    "C06": ("安全状态要求存在可满足所有进程最大剩余需求的一种完成顺序。",
+            "找不到安全序列说明系统不安全，当前是否已死锁取决于实际等待关系。"),
+}
+
+
+def record(identity, text):
+    claim = {"claim_id": "SYNTH-" + identity, "kind": "observation", "basis": "observed_attempt",
+             "lifecycle": "current", "evidence_status": "explicit_gap", "content": text,
+             "event_at": "2026-11-01", "recorded_at": "2026-11-04T03:00:00+00:00"}
+    personal = teaching.selected_context(
+        {"claims_schema": teaching.CLAIMS_SCHEMA, "claims": [claim]}, identity, "test-version")
+    return {
+        "knowledge_point": identity, "status": "semantic_current",
+        "syllabus_context": {"scope_status": "in_scope", "teaching_boundary": "本题条件",
+                             "exam_frequency": {"total_count": 1}},
+        "concept_brief": {"description": "可按需展开的释义。" * 35},
+        "personal_context": personal,
+    }
+
+
+class BoundedEvidenceTests(unittest.TestCase):
+    def test_independent_conditions_remain_atomic_across_points(self):
+        for identifier, conditions in CASES.items():
+            with self.subTest(case=identifier):
+                left, right = (record(f"{identifier}-{i}", text)
+                               for i, text in enumerate(conditions, start=1))
+                payload = {"records": [left, right], "returned": 2}
+                result = teaching.fit(payload, 1950)
+                self.assertEqual(result["returned"], 2)
+                self.assertEqual(result["omitted_points"], [])
+                self.assertTrue(result["truncated"])
+                for row, expected in zip(result["records"], conditions):
+                    self.assertIn("concept_brief", row["omitted_fields"])
+                    self.assertEqual(row["syllabus_context"]["teaching_boundary"], "本题条件")
+                    claim, = row["personal_context"]["claim_view"]["claims"]
+                    self.assertEqual(claim["content"], expected)
+                    self.assertEqual(claim["recorded_at"], "2026-11-04T03:00:00+00:00")
+                size = len(json.dumps(result, ensure_ascii=False, separators=(",", ":")).encode()) + 1
+                self.assertEqual(result["serialized_bytes"], size)
+                self.assertLessEqual(size, 1950)
+
+    def test_followup_metadata_restored_when_it_fits(self):
+        point = record("C01-1", CASES["C01"][0])
+        result = teaching.fit({"records": [point], "returned": 1}, 8192)
+        row, = result["records"]
+        self.assertIn("concept_brief", row)
+        self.assertNotIn("omitted_fields", row)
+        self.assertFalse(result["truncated"])
+
+
+if __name__ == "__main__":
+    unittest.main()
