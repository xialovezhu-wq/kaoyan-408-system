+    def check_unit(self, records, point, body):
+        memory = next(record["personal_context"] for record in records if record["knowledge_point"] == point)
+        self.assertEqual("historical_evidence", memory["repair_evidence"]["status"])
+        unit = next(unit for unit in memory["repair_evidence"]["units"] if unit["content"] == body)
+        self.assertEqual("historical_repair", unit["role"])
+        self.assertEqual("graded_repair", unit["review_status"])
+        self.assertEqual("hint_or_prompted", unit["prompt_dependency"])
+        self.assertEqual(point, unit["knowledge_point"])
+        self.assertRegex(unit["source_sha256"], r"^[0-9a-f]{64}$")
+        self.assertEqual(unit["source_sha256"], unit["revision_sha256"])
+        proof = memory["evidence_object"]
+        raw = (self.state / proof["ref"]).read_bytes()
+        self.assertEqual(proof["sha256"], hashlib.sha256(raw).hexdigest())
+        self.assertEqual(body, json.loads(raw)["records"][unit["record_key"]]["summary"])
