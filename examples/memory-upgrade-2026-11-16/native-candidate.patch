+"""Synthetic verification of corrections through the native 408 resolver."""
+import hashlib
+import json
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+import test_exam_tutoring_context_408 as fixtures
+from exam_tutoring_context_408 import (QUERY_INPUT_SCHEMA, REVIEW_LEDGER_REL, query_context,
+                                       refresh_after_commit)
+from knowledge_learning_paths_408 import _excerpt, build_path
+from knowledge_profile_408 import CLAIMS_SCHEMA, apply_updates, claim_key
+from teaching_memory_408 import fit, selected_context
+
+ROOT = Path(__file__).resolve().parents[1]
+OLD = "把 TLB 未命中直接视作缺页。"
+FIX = "TLB 未命中后需要检查页表。"
+CONDITION = "只有合法访问所需的页面不在内存时才触发缺页。"
+OTHER = "采用写回策略且写命中时，只需要先更新本级缓存。"
+
+
+class CorrectionBudgetTests(unittest.TestCase):
+    setUp = fixtures.ExamTutoringContext408Tests.setUp
+    tearDown = fixtures.ExamTutoringContext408Tests.tearDown
+    refresh = fixtures.ExamTutoringContext408Tests.refresh
+
+    def append_records(self, changes):
+        path = self.repo / REVIEW_LEDGER_REL
+        baseline = json.loads(path.read_text().splitlines()[0])
+        with path.open("a", encoding="utf-8") as ledger:
+            for idx, (point, text, values) in enumerate(changes):
+                date = values.get("observed_date", "2026-08-29")
+                event = {**baseline, "event_id": f"RE-correction-budget-{point}-{idx}",
+                         "knowledge_points": [point], "understanding_summary": text,
+                         "observed_date": date, "event_time": date + "T08:00:00+08:00", **values}
+                ledger.write(json.dumps(event, ensure_ascii=False) + "\n")
+
+    def prepare(self, questions, *, reverse=False, ungraded=(), wrong=()):
+        (self.repo / "知识点标签表.md").write_text("\n".join(f"- {row[0]} 合成机制 {row[0]}"
+                                                      for row in questions) + "\n")
+        changes = []
+        for point, old, repair, condition, alternative in questions:
+            old_event = {"prompt_dependency": "independent", "observed_date": "2026-08-30" if reverse else "2026-08-27"}
+            repair_event = {"event_kind": "repair", "prompt_dependency": "hint_or_prompted",
+                            "correction_result": "correct", "correction_conclusion": "correct"}
+            if point in ungraded:
+                repair_event.update(correction_conclusion=None, correction_result="uncertain")
+            if point in wrong:
+                repair_event["correction_conclusion"] = "wrong"
+            changes += [(point, old + "补充旧答细节以填充旧预算。" * 20, old_event),
+                        (point, repair + condition, repair_event)]
+            if alternative:
+                changes.append((point, alternative, repair_event))
