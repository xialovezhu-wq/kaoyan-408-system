+"""Offline full-query holdout. Runtime code never sees this rubric."""
+import json
+import unittest
+from pathlib import Path
+
+import test_correction_budget_408 as dev
+from exam_tutoring_context_408 import REVIEW_LEDGER_REL
+
+
+CORPUS = Path(__file__).parent / "fixtures/correction_budget_408_holdout.json"
+
+
+class HeldOutCorrectionBudgetTests(unittest.TestCase):
+    setUp = dev.CorrectionBudgetTests.setUp
+    tearDown = dev.CorrectionBudgetTests.tearDown
+    refresh = dev.CorrectionBudgetTests.refresh
+    append_records = dev.CorrectionBudgetTests.append_records
+    prepare = dev.CorrectionBudgetTests.prepare
+    check_unit = dev.CorrectionBudgetTests.check_unit
+    resolve = dev.CorrectionBudgetTests.resolve
+
+    @classmethod
+    def setUpClass(cls):
+        cls.corpus = json.loads(CORPUS.read_bytes())
+
+    def test_heldout_condition_changes_in_all_four_disciplines(self):
+        cases = self.corpus["repairs"]
+        ledger = self.repo / REVIEW_LEDGER_REL
+        initial = ledger.read_bytes()
+        for start in range(0, len(cases), 2):
+            pair = cases[start:start + 2]
+            ledger.write_bytes(initial)
+            self.prepare(pair, reverse=bool(start % 4))
+            formal = ledger.read_bytes()
+            points = [row[0] for row in pair]
+            packet = self.resolve(*points)
+            self.assertEqual("available", packet["status"])
+            self.assertEqual(0, packet["write_count"])
+            self.assertLessEqual(packet["serialized_bytes"], 8192)
+            text = json.dumps(packet, ensure_ascii=False)
+            for point, old, repair, condition, alternative in pair:
+                with self.subTest(point=point):
+                    self.check_unit(packet["records"], point, repair + condition)
+                    self.check_unit(packet["records"], point, alternative)
+                    self.assertNotIn(old, text)
+            self.assertEqual(formal, ledger.read_bytes())
+
+    def test_heldout_controls(self):
+        old, correction, scope = "索引记录总是存一份完整数据。", "索引可保存定位信息。", "此题使用间接引用而非聚簇索引叶节点。"
+        point, unreviewed, wrong, ordinary = "OS97-31", "OS97-32", "OS97-33", "DS98-31"
+        self.prepare([(code, old, correction, scope, "") for code in (point, unreviewed, wrong)],
+                     ungraded=(unreviewed,), wrong=(wrong,))
+        taxonomy = self.repo / "知识点标签表.md"
+        taxonomy.write_text(taxonomy.read_text() + f"- {ordinary} 合成普通查询\n")
+        self.append_records([(ordinary, "单链表可以通过后继指针继续遍历。", {})])
+        self.refresh()
+        available = self.resolve(point)
+        for control in self.corpus["controls"]:
+            with self.subTest(control=control):
+                if control == "ordinary_without_repair":
+                    record = self.resolve(ordinary)["records"][0]
+                    self.assertNotIn("repair_evidence", record["personal_context"])
+                elif control == "unknown_point":
+                    self.assertIn("CN97-31", self.resolve(point, "CN97-31")["missing_points"])
+                elif control == "protected":
+                    raw = json.dumps(self.resolve(point, view="protected"), ensure_ascii=False)
+                    for hidden in (old, correction, scope, "repair_evidence", "evidence_object"):
+                        self.assertNotIn(hidden, raw)
+                elif control == "source_drift":
+                    ledger = self.repo / REVIEW_LEDGER_REL
+                    before = ledger.read_bytes()
+                    try:
+                        self.append_records([("OS03-17", "新一条有版本的合成记录。", {})])
+                        self.assertEqual("unavailable", self.resolve(point, known=available["version"])["status"])
+                    finally:
+                        ledger.write_bytes(before)
+                    self.refresh()
+                    available = self.resolve(point)
+                elif control == "known_version":
+                    self.assertEqual("unchanged", self.resolve(point, known=available["version"])["status"])
+                elif control == "question_part_withheld":
+                    scoped = self.resolve(point, formal_id="OS_2020_001", current_question_part="P01")
+                    record = next(row for row in scoped["records"] if row["knowledge_point"] == point)
+                    self.assertEqual("withheld_scope", record["personal_context"]["status"])
+                    self.assertNotIn(correction, json.dumps(scoped, ensure_ascii=False))
+                else:
+                    identity = wrong if control == "explicit_wrong_repair" else unreviewed
+                    e = self.resolve(identity)["records"][0]["personal_context"]["repair_evidence"]
+                    self.assertEqual("review_required", e["status"])
+                    self.assertEqual([], e["units"])
+
+
+if __name__ == "__main__":
+    unittest.main()
