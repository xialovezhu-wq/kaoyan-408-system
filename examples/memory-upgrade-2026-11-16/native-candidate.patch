index 0000000000000000000000000000000000000000..afc668dc38390ec1e6089b374ab1cb3b08a0d6f9
--- /dev/null
+++ b/tests/benchmark_correction_budget_408.py
@@ -0,0 +1,155 @@
+"""Compare two checkouts against the same generated synthetic resolver input."""
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+import resource
+import statistics
+import subprocess
+import sys
+import time
+
+
+def compact(value):
+    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+
+
+def percentile(values, fraction):
+    return sorted(values)[math.ceil(len(values) * fraction) - 1]
+
+
+def query(repo, state, points, budget):
+    from exam_tutoring_context_408 import QUERY_INPUT_SCHEMA, query_context
+    return query_context(repo, {"schema": QUERY_INPUT_SCHEMA, "stage": "post_answer",
+        "knowledge_points": points, "max_profiles": 0, "max_bytes": budget, "read_stats": True},
+        output_root=state, max_bytes=budget, teaching_view="after_attempt", personal_scope="teaching", materials="core")
+
+
+def metrics(value, raw):
+    result = {"status": value["status"], "bytes": len(raw), "returned": value.get("returned"),
+              "truncated": value["truncated"], "write_count": value["write_count"],
+              "reads": value["read_stats"]["artifact_count"], "read_bytes": value["read_stats"]["artifact_bytes"]}
+    result["whole_units"] = sum(len((row.get("personal_context") or {}).get("repair_evidence", {}).get("units", []))
+                                for row in value["records"])
+    return result
+
+
+def worker(root):
+    sys.path[:0] = [str(root / "scripts"), str(root / "tests")]
+    from exam_tutoring_context_408 import DEFAULT_STATE_REL, REVIEW_LEDGER_REL
+    from test_correction_budget_408 import CorrectionBudgetTests, OLD, FIX, CONDITION, OTHER
+    fixture = CorrectionBudgetTests()
+    fixture.setUp()
+    try:
+        fixture.state = fixture.repo / DEFAULT_STATE_REL
+        cases = [("OS99-10", OLD, FIX, "本次题设另有界定条件。" * 20 + CONDITION, ""),
+                 ("CO99-10", "击中后总写下一级。", OTHER, "题设明确这是写回命中。" * 19, ""),
+                 ("CN99-10", "失序分组总被保留。", "超出接收窗口的帧丢弃。", "帧已经落在当前窗口右边界之后。" * 20, "")]
+        fixture.prepare(cases)
+        ledger = fixture.repo / REVIEW_LEDGER_REL
+        before = hashlib.sha256(ledger.read_bytes()).hexdigest()
+        print(compact({"repo": str(fixture.repo), "state": str(fixture.state), "source_sha256": before,
+                       "source_lines": len(ledger.read_bytes().splitlines())}), flush=True)
+        for line in sys.stdin:
+            request = json.loads(line)
+            if request == "close":
+                print(compact({"formal_unchanged": hashlib.sha256(ledger.read_bytes()).hexdigest() == before,
+                               "warm_peak_rss_bytes_including_fixture_setup": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}), flush=True)
+                return
+            t0 = time.perf_counter_ns()
+            value = query(fixture.repo, fixture.state, **request)
+            raw = (compact(value) + "\n").encode()
+            print(compact(metrics(value, raw) | {"ms": (time.perf_counter_ns()-t0) / 1e6}), flush=True)
+    finally:
+        fixture.tearDown()
+
+
+def interleaved(baseline, candidate, iterations):
+    roots = {"B1": baseline, "B2": candidate}
+    groups = {"single_ordinary": {"points": ["OS03-17"], "budget": 8192},
+              "multi_tight": {"points": ["OS99-10", "CO99-10", "CN99-10"], "budget": 4500},
+              "multi_default": {"points": ["OS99-10", "CO99-10", "CN99-10"], "budget": 8192}}
+    workers = {side: subprocess.Popen([sys.executable, __file__, "worker", str(root)],
+                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
+               for side, root in roots.items()}
+    try:
+        receipts = {side: json.loads(proc.stdout.readline()) for side, proc in workers.items()}
+        if receipts["B1"]["source_sha256"] != receipts["B2"]["source_sha256"]:
+            raise ValueError("control_fixture_drifted")
+        def invoke(side, mode, request):
+            if mode == "warm":
+                proc = workers[side]
+                proc.stdin.write(compact(request) + "\n")
+                proc.stdin.flush()
+                return json.loads(proc.stdout.readline())
+            command = [sys.executable, str(roots[side] / "scripts/exam_tutoring_context_408.py"),
+                       "resolve", "--repo", receipts[side]["repo"], "--output-root", receipts[side]["state"],
+                       "--view", "after_attempt", "--personal-scope", "teaching", "--materials", "core",
+                       "--max-bytes", str(request["budget"]), "--read-stats"]
+            for point in request["points"]:
+                command.extend(["--concept", point])
+            t0 = time.perf_counter_ns()
+            raw = subprocess.check_output(command, timeout=10)
+            return metrics(json.loads(raw), raw) | {"ms": (time.perf_counter_ns()-t0) / 1e6}
+
+        measurements = {}
+        for mode in ("warm", "cold_cli"):
+            for name, request in groups.items():
+                if mode == "warm":
+                    for side in roots:
+                        invoke(side, mode, request)
+                rows = {side: [] for side in roots}
+                for repetition in range(iterations):
+                    for side in (roots if repetition % 2 == 0 else reversed(roots)):
+                        row = invoke(side, mode, request)
+                        if (row["status"] != "available" or row["returned"] != len(request["points"])
+                                or row["bytes"] > request["budget"] or row["write_count"] != 0):
+                            raise ValueError(name + ":wrong_query_result:" + side)
+                        rows[side].append(row)
+                measures = {side: {"p50_ms": statistics.median([r["ms"] for r in seq]),
+                    "p95_ms": percentile([r["ms"] for r in seq], .95),
+                    "query": {key: item for key, item in seq[0].items() if key != "ms"}} for side, seq in rows.items()}
+                b1, b2 = (measures[side]["p95_ms"] for side in roots)
+                measures["pass"] = (b2 <= max(b1 * 1.05, b1 + 20) and b2 <= 100 if mode == "warm" else b2 <= 250)
+                measurements[mode + "/" + name] = {"summary": measures, "samples": rows}
+        legacy = {}
+        for side, root in roots.items():
+            raw = subprocess.check_output([sys.executable, str(root / "scripts/benchmark_knowledge_tutoring_408.py"),
+                "--repo", receipts[side]["repo"], "--iterations", str(iterations)], timeout=30)
+            legacy[side] = json.loads(raw)
+        end = {}
+        for side, proc in workers.items():
+            proc.stdin.write('"close"\n')
+            proc.stdin.flush()
+            end[side] = json.loads(proc.stdout.readline())
+        return {"trials_per_arm_per_group": iterations, "freeze_sha256": receipts["B1"]["source_sha256"],
+                "formal_events_per_arm": receipts["B1"]["source_lines"], "paired": measurements,
+                "existing_benchmark": legacy, "final": end}
+    finally:
+        for process in workers.values():
+            process.stdin.close()
+            try:
+                process.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+
+
+if __name__ == "__main__":
+    if sys.argv[1:2] == ["worker"]:
+        worker(Path(sys.argv[2]))
+    else:
+        parser = argparse.ArgumentParser(description=__doc__)
+        parser.add_argument("--baseline", type=Path, required=True)
+        parser.add_argument("--candidate", type=Path, required=True)
+        parser.add_argument("--output", type=Path, required=True)
+        args = parser.parse_args()
+        result = interleaved(args.baseline, args.candidate, 30)
+        args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n")
+        for label, pair in result["paired"].items():
+            print(label, compact(pair["summary"]))
+        for side, legacy in result["existing_benchmark"].items():
+            print(side, "legacy", legacy["all_queries_ready"], legacy["local_budget_pass"], legacy["function_p95_ms"],
+                  max(row["cli_ms"] for row in legacy["cli_samples"]))
+        print("formal", result["final"])
